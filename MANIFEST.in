recursive-include graphslim/configs *.json
include CHANGELOG.md
recursive-include constraints *.txt
include graphslim/THIRD_PARTY_NOTICES.md
recursive-include graphslim/licenses *.txt
recursive-include graphslim/sparsification/fixed_idx *.npy
recursive-include graphslim/scripts *.sh *.txt
recursive-include graphslim/evaluation/scripts *.sh
recursive-include examples *.py *.json
recursive-include tests *.py
recursive-include benchmark *.py *.md *.sh *.json *.csv *.txt
recursive-include docs *.rst *.md *.py *.txt
recursive-include validation *.md *.json *.xml *.log *.txt
prune docs/_build
global-exclude .DS_Store ._* *.py[cod] *.bak
